import java.util.*;
public class Main
{
	public static void main(String[] args) 
	{
		Scanner x=new Scanner(System.in);
		int marks[]=new int[5];
		String names[]=new String[5];
		for(int i=0;i<5;i++)
		{
		    System.out.println("Enter marks and names of stud"+(i+1));
		    marks[i]=x.nextInt();
		    x.nextLine();
		    names[i]=x.nextLine();
		}
		System.out.println("______________________");
		int s=1;
		for(int i=0;i<5;i++)
		{
		    if(marks[i]>50)
		    {
		        System.out.println(s+" "+ names[i]+" "+ "has scored" +" "+marks[i]);
		        s++;
		    }
		}
	}
}
