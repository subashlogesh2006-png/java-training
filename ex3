import java.util.Scanner;
class rect
{
    int a,c;
    rect(int l,int b)
    {
    a=l;
    c=b;
    }
    public void display()
    {
        System.out.println("Area of the rectangle is:"+(a*c));
    }
}
public class main{
    public static void main(String args[])
    {
        int l,b;
        Scanner a=new Scanner(System.in);
        int n=a.nextInt();
        System.out.println("Enter the number of rectangle"+n);
        rect[] r=new rect[n];
        for(int i=0;i<n;i++)
        {
            System.out.println("Enter the length of the rectangle"+(i+1));
            l=a.nextInt();
            System.out.println("Enter the breadth of the rectangle"+(i+1));
            b=a.nextInt();
            r[i]=new rect(l,b);
        }
        for (int i=0;i<n;i++)
        {
            System.out.println("Area of the rectangle:"+(i+1));
            r[i].display();
        }
    }
}
