public class Main
{
    public static void main(String args[])
    {
        int d;
        boolean f;
        for(int i = 100; i < 1000; i++)
        {
            f = true;
            int n = i;
            while(n != 0)
            {
                d = n % 10;
                if(d != 2 && d != 3 && d != 5 && d != 7)
                {
                    f = false;
                    break;
                }
                n = n / 10;
            }
            if(f == true)
            {
                System.out.println(i);
            }
        }
    }
}
