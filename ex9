public class Main
{
    public static void main(String args[])
    {
        int d, count;
        int total = 0;

        for(int i = 250; i <= 750; i++)
        {
            int n = i;
            count = 0;
            while(n != 0)
            {
                d = n % 10;
                if(d == 2 || d == 3 || d == 5 || d == 7)
                {
                    count++;
                }
                n = n / 10;
            }
            if(count == 2)
            {
                total++;
            }
        }
        System.out.println("Total = " + total);
    }
}
